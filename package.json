  "engines": {
    "node": ">=22.12.0"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.0.8",
    "youtubei.js": "^18.0.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
