# --- Discord (required) -------------------------------------------------------
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
# Register commands to a single guild for instant updates while developing.
# Leave empty to register globally (takes up to an hour to propagate).
DISCORD_GUILD_ID=

# --- YouTube (optional) -------------------------------------------------------
# Cookie string from a logged-in browser session; needed for age-restricted videos.
YOUTUBE_COOKIE=
# Proof-of-origin token + visitor data, only if YouTube starts blocking your server's IP.
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=
# InnerTube clients to try, in order, when fetching an audio stream. The bot automatically
# falls back to the next client if a stream is rejected (HTTP 403), even mid-playback.
# Which clients YouTube accepts changes over time and by server IP; reorder these if you get
# repeated 403s. Valid values: VISIONOS, IOS, MWEB, ANDROID_VR, WEB, ANDROID, TV_EMBEDDED, WEB_EMBEDDED
YOUTUBE_CLIENTS=VISIONOS,IOS,MWEB,ANDROID_VR
# Where youtubei.js caches its session/player data.
YOUTUBE_CACHE_DIR=.cache/youtubei
YOUTUBE_REQUEST_TIMEOUT_MS=20000

# --- Player behaviour (optional) ---------------------------------------------
# Seconds to wait in an empty queue before leaving the voice channel (0 = never).
IDLE_TIMEOUT_SECONDS=300
# Seconds to wait alone in a voice channel before leaving (0 = never).
EMPTY_CHANNEL_TIMEOUT_SECONDS=60
MAX_QUEUE_SIZE=500
MAX_PLAYLIST_SIZE=200
DEFAULT_VOLUME=50
MAX_VOLUME=100
HISTORY_SIZE=50
# Post a "Now playing" message in the channel whenever a new track starts.
ANNOUNCE_NOW_PLAYING=true

# --- Logging ------------------------------------------------------------------
# debug | info | warn | error | silent
LOG_LEVEL=info
